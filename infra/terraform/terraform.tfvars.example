# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)

# Your public IP for SSH:  curl -s https://ifconfig.me
admin_cidrs = ["203.0.113.10/32"]

region              = "mia"          # mia | atl | ewr ...
plan                = "vc2-2c-4gb"
admin_user          = "juanjo"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# VPC (must not overlap 172.30.0.0/24 jail or 172.17.0.0/16 docker)
vpc_subnet      = "10.40.0.0"
vpc_subnet_mask = 24

# Public repo -> cloud-init clones + bootstraps on first boot.
# Private repo -> leave empty and use `make tf-sync tf-bootstrap`.
repo_url = ""
repo_ref = "main"

enable_gvisor    = true
create_inference = true
use_reserved_ip  = false
expose_api_port  = false
