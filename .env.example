# ---- Host-only secrets (NEVER passed to the sandbox) ----
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Set after `make check-models --probe` confirms tool calling
AGENT_MODEL=qwen3.8-27b

# Day 2 threat-intel keys (host-side tools)
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=

# ---- Sandbox ----
SANDBOX_IMAGE=ioc-sentinel/sandbox-browser:latest
SANDBOX_NETWORK=ioc-jail
# runsc = gVisor (after `sudo make gvisor`); leave empty for runc
SANDBOX_RUNTIME=
SANDBOX_TIMEOUT_S=60
SANDBOX_MEM=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS=512
SANDBOX_DNS=1.1.1.1,9.9.9.9
NAV_TIMEOUT_MS=20000
DWELL_MS=3000

# Local trap testing ONLY: host:port exceptions punched through the jail
LAB_ALLOW=
